---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Sections from '../components/Sections.astro';
import Faq from '../components/Faq.astro';
import Close from '../components/Close.astro';
import { pic } from '../data/pictures';
import { data, langOf, ui } from '../lib/i18n';
import type { Section } from '../data/page-types';

const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const { serviceGroups } = data[lang];

// The picture beside each kind of care.
const pics: Record<string, string> = {
  cleaning: 'stone-kitchen.jpg',
  restoration: 'carpet-restoration.jpg',
  recurring: 'essential.jpg',
  preparation: 'market-ready.jpg',
  concierge: 'limestone-fireplace.jpeg',
  commercial: 'commercial.jpg',
};

// What each kind of care is, in plain words.
const copy = {
  en: {
    title: 'Home Care Services in San Antonio, TX | Diamond Shine',
    description: 'Specialized cleaning, surface restoration, recurring care, property preparation, private concierge and commercial care for San Antonio homes and businesses.',
    h1: 'Home care services in San&nbsp;Antonio,&nbsp;TX.',
    lead: 'Specialized cleaning, restoration and recurring care for private residences, with property preparation, concierge and commercial care from the same family.',
    closeTitle: 'Not sure where to begin?',
    closeText: 'Share your home and preferred timing. We will confirm the scope, pricing and availability with you before anything is reserved.',
    details: {
      cleaning: 'Routine and detailed home cleaning designed around the condition of your property and the level of care it needs, from everyday upkeep to a complete reset before or after a move.',
      restoration: 'Specialized care for heavily used flooring and surfaces, soil and buildup, along with interior painting and concrete pressure washing. Results vary with material and condition, and expectations are discussed before approval.',
      recurring: 'Ongoing care for clients who want consistent results after a deep clean, move-in reset, restoration service or seasonal refresh, with optional finishing details.',
      preparation: 'Cleaning, restoration, presentation care and select touch-ups before photography, showings, open houses and final walkthroughs, for homeowners, Realtors, investors, property managers and families on PCS orders.',
      concierge: 'One point of contact for your agreed home-care schedule, household priorities, arrivals and outside-provider coordination. We begin with a private consultation and a written plan that sets out capacity, costs and approvals.',
      commercial: 'Care for offices, administrative spaces and client-facing facilities, for organizations that value presentation, consistency, discretion, communication and trusted service.',
    } as Record<string, string>,
    begin: [
      {
        kind: 'plate',
        title: 'Let the home tell us',
        text: 'An evaluation is a conversation and a walkthrough, not a sales appointment. We review the home and recommend what to do first: cleaning, restoration, market-ready preparation or recurring care.',
        pic: 'gloved-hand-stone.jpg',
        flip: true,
        note: 'Requesting one does not commit you to a service. [How an evaluation works](/home-evaluation)',
      },
    ] as Section[],
    faq: [
      { q: 'How is pricing determined?', a: 'Individually, based on the property’s condition, size, materials, access, frequency and the work you approve. Before work begins, a signed agreement sets out the scope, price, payment terms and responsibilities.' },
      { q: 'Can I send photos for a quote?', a: 'Yes. Photos are welcome and help us understand the condition. Please keep people, documents and valuables out of view.' },
      { q: 'When is payment due, and what do you accept?', a: 'Payment terms are set out in your signed agreement. Zelle is our primary payment method. Secure digital payments may also be available through Square when available. [confirm:square]' },
      { q: 'What is outside the scope of your services?', a: 'We do not perform plumbing, mold remediation, pest control, electrical, HVAC, structural repair, or flooring and countertop replacement, and we do not issue inspections or certifications. When we see one of those concerns, we tell you and refer you to the appropriate licensed trade.' },
      { q: 'Can carpet or grout always be fully restored?', a: 'No. Permanent stains, dye loss, damaged fibers and cracked grout may remain. Results vary by material, age, prior treatment, source, severity and condition. [Read the limits](/restoration#limits).' },
      { q: 'What areas do you serve?', a: 'San Antonio and surrounding Hill Country and I-35 corridor communities. [See the full list](/service-areas). Travel outside the area is considered case by case.' },
      { q: 'Can pets stay home during the service?', a: 'Please secure pets or tell us your pet-access instructions before we arrive.' },
    ],
  },
  es: {
    title: 'Servicios de cuidado del hogar en San Antonio, TX | Diamond Shine',
    description: 'Limpieza especializada, restauración de superficies, cuidado recurrente, preparación de propiedades, concierge privado y cuidado comercial para casas y negocios de San Antonio.',
    h1: 'Servicios de cuidado del hogar en San&nbsp;Antonio,&nbsp;TX.',
    lead: 'Limpieza especializada, restauración y cuidado recurrente para residencias privadas, con preparación de propiedades, concierge y cuidado comercial de la misma familia.',
    closeTitle: '¿No sabe por dónde empezar?',
    closeText: 'Cuéntenos sobre su casa y los tiempos que prefiere. Confirmaremos con usted el alcance, el precio y la disponibilidad antes de reservar nada.',
    details: {
      cleaning: 'Limpieza del hogar rutinaria y detallada, pensada según el estado de su propiedad y el nivel de cuidado que necesita, desde el mantenimiento diario hasta una renovación completa antes o después de una mudanza.',
      restoration: 'Cuidado especializado para pisos y superficies de mucho uso, con suciedad y acumulación, junto con pintura interior y lavado a presión de concreto. Los resultados varían según el material y el estado, y las expectativas se hablan antes de la aprobación.',
      recurring: 'Cuidado continuo para clientes que quieren resultados constantes después de una limpieza profunda, una renovación de mudanza, un servicio de restauración o un refresco de temporada, con detalles de acabado opcionales.',
      preparation: 'Limpieza, restauración, cuidado de la presentación y algunos retoques antes de fotografías, visitas, casas abiertas y recorridos finales, para propietarios, agentes inmobiliarios, inversionistas, administradores de propiedades y familias con órdenes PCS.',
      concierge: 'Un solo punto de contacto para su calendario de cuidado acordado, las prioridades del hogar, las llegadas y la coordinación de proveedores externos. Empezamos con una consulta privada y un plan por escrito que establece la capacidad, los costos y las aprobaciones.',
      commercial: 'Cuidado de oficinas, espacios administrativos e instalaciones de atención al público, para organizaciones que valoran la presentación, la constancia, la discreción, la comunicación y un servicio de confianza.',
    } as Record<string, string>,
    begin: [
      {
        kind: 'plate',
        title: 'Deje que la casa nos lo diga',
        text: 'Una evaluación es una conversación y un recorrido, no una cita de ventas. Revisamos la casa y le recomendamos qué hacer primero: limpieza, restauración, preparación para la venta o cuidado recurrente.',
        pic: 'gloved-hand-stone.jpg',
        flip: true,
        note: 'Solicitarla no le compromete a ningún servicio. [Cómo funciona una evaluación](/home-evaluation)',
      },
    ] as Section[],
    faq: [
      { q: '¿Cómo se determina el precio?', a: 'De forma individual, según el estado de la propiedad, su tamaño, los materiales, el acceso, la frecuencia y el trabajo que usted apruebe. Antes de empezar, un acuerdo firmado establece el alcance, el precio, las condiciones de pago y las responsabilidades.' },
      { q: '¿Puedo enviar fotos para una cotización?', a: 'Sí. Las fotos son bienvenidas y nos ayudan a entender el estado. Por favor, deje fuera de la imagen a las personas, los documentos y los objetos de valor.' },
      { q: '¿Cuándo se paga y qué formas de pago aceptan?', a: 'Las condiciones de pago se establecen en su acuerdo firmado. Zelle es nuestro método de pago principal. También puede haber pagos digitales seguros a través de Square, cuando estén disponibles. [confirm:square]' },
      { q: '¿Qué queda fuera de sus servicios?', a: 'No hacemos plomería, remediación de moho, control de plagas, trabajos eléctricos, climatización (HVAC), reparaciones estructurales ni reemplazo de pisos o encimeras, y no emitimos inspecciones ni certificaciones. Cuando vemos alguno de esos problemas, se lo decimos y le recomendamos al profesional con licencia adecuado.' },
      { q: '¿Siempre se pueden restaurar por completo la alfombra o las juntas?', a: 'No. Pueden quedar manchas permanentes, pérdida de color, fibras dañadas y juntas agrietadas. Los resultados varían según el material, la antigüedad, los tratamientos previos, el origen, la gravedad y el estado. [Lea los límites](/restoration#limits).' },
      { q: '¿Qué zonas atienden?', a: 'San Antonio y las comunidades cercanas del Hill Country y del corredor de la I-35. [Vea la lista completa](/service-areas). Los traslados fuera de la zona se consideran caso por caso.' },
      { q: '¿Pueden quedarse las mascotas en casa durante el servicio?', a: 'Por favor, asegure a sus mascotas o díganos sus instrucciones de acceso para mascotas antes de que lleguemos.' },
    ],
  },
};
const c = copy[lang];
---
<Base title={c.title} description={c.description} service="not-sure">
  <PageHero h1={c.h1} lead={c.lead} main="hero-services.jpg" service="not-sure" review="kristina" />

  {serviceGroups.map((g, i) => (
    <section id={g.id} class:list={['section', { 'section--soft': i % 2 === 1 }]}>
      <div class:list={['wrap split', { 'split--flip': i % 2 === 1 }]}>
        <div class="stack">
          <h2><a class="h-link" href={g.href}>{g.name}</a></h2>
          <p>{c.details[g.id]}</p>
          {g.links.length > 1 && (
            <ul class="link-list">
              {g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          )}
          <p><a class="btn btn--line" href={g.href}>{t.seeDetails}</a></p>
        </div>
        <Photo {...pic(pics[g.id])} ratio={1.4} show={580} sizes="(min-width: 1248px) 576px, (min-width: 900px) 46vw, 100vw" />
      </div>
    </section>
  ))}

  <Sections sections={c.begin} />
  <Faq items={c.faq} soft />
  <Close title={c.closeTitle} text={c.closeText} picture="limestone-entrance.webp" service="not-sure" review="serena" />
</Base>

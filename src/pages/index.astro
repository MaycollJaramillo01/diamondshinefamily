---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Cta from '../components/Cta.astro';
import Facets from '../components/Facets.astro';
import { pic } from '../data/pictures';
import { rich } from '../lib/rich';
import { brand, areas } from '../data/brand';
import { data, langOf, ui } from '../lib/i18n';

const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const { serviceGroups, stories, people, reviews } = data[lang];

const copy = {
  en: {
    title: `Home Preservation & Care in San Antonio, TX | ${brand.name}`,
    description: 'Family-owned home preservation and care in San Antonio since 2017: specialized cleaning, surface restoration and recurring care for private residences. Request a Home Evaluation.',
    line: 'Home preservation and care for San Antonio’s finest homes, from the Leal family since 2017.',
    numbers: 'Diamond Shine in numbers',
    homes: 'Homes served [confirm:homes-8000]',
    since: 'Family-owned since',
    towns: 'Communities we serve',
    method: 'Every surface, its own method.',
    methodLead: 'One wrong product can dull a stone floor for good. We match the method to the material and review it with you, area by area.',
    // Every surface has its own method: three of them, side by side, at one size.
    surfaces: [
      { name: 'Stone and tile', text: 'Natural stone, tile and the grout between, each cleaned with what it can take.', pic: 'gloved-hand-stone.jpg' },
      { name: 'Wood', text: 'Cabinetry, hardwood and fine furniture, cleaned to suit the finish.', pic: 'white-glove-detail.webp' },
      { name: 'Walls and trim', text: 'Interior painting, cut in by hand along every line of trim.', pic: 'painting-hand.jpg' },
    ],
    care: 'The care we offer',
    careLead: 'Every service is quoted in writing before work begins.',
    // The service card: a price only where the company publishes one.
    prices: { '/floor-ritual': '+$25 to $35 a visit', '/white-glove-society': '$495 a year' } as Record<string, string>,
    walk: 'The walkthrough',
    walkLead: 'Every Home Evaluation is a walk through the house with you. Walk yours here, and mark each area the way we would.',
    // The walkthrough of a Home Evaluation, room by room.
    rooms: [
      { name: 'The entrance', text: 'Stone and glass at the door, the threshold, and the floor everyone walks in on.', pic: 'entry.jpeg' },
      { name: 'The living room', text: 'Wood, stone, the fireplace and the details a room is judged by.', pic: 'limestone-fireplace.jpeg' },
      { name: 'The kitchen', text: 'Stone counters, cabinet fronts, appliances and the grout between the tiles.', pic: 'stone-kitchen.jpg' },
      { name: 'The floors', text: 'Tile, grout, hardwood and natural stone, each with its own method.', pic: 'travertine.jpg' },
      { name: 'The carpeted rooms', text: 'Traffic lanes, pet areas and the rooms used most, and what can be restored.', pic: 'carpet-room.webp' },
      { name: 'The bedrooms', text: 'Linens, beds and the rooms a guest notices first.', pic: 'bed-presentation.jpg' },
    ],
    marks: ['Maintain', 'Restore', 'Priority'],
    mark: 'Mark',
    plan: 'Your plan',
    planText: 'After the walkthrough you receive a written plan in plain English, every area marked Maintain, Restore or Priority. Every service then starts with a signed agreement covering scope, price, payment terms and responsibilities.',
    planEmpty: 'Mark a room above and it appears here.',
    planNote: 'No obligation. A request does not reserve a date or take payment.',
    notesIntro: 'From the walkthrough on the home page.',
    family: 'The Leal family',
    familyLead: 'Lilian and Sergio Leal founded Diamond Shine in San Antonio in 2017, and Emilio Leal leads it today. The family you speak with is the family accountable for the work.',
    voice: 'Sergio Leal, in his own words',
    work: 'Our work, in writing',
    workLead: 'Each case record sets out the home and the plan of care, in plain words.',
    workNote: 'Illustrative photograph',
    allCases: 'Every case record',
    allReviews: 'Every review, in full',
    visit: 'Start with a walkthrough',
    visitAreas: 'Homes in San Antonio, Alamo Heights, Terrell Hills, Olmos Park, Boerne and [nearby communities](/service-areas).',
  },
  es: {
    title: `Preservación y Cuidado del Hogar en San Antonio, TX | ${brand.name}`,
    description: 'Preservación y cuidado del hogar en San Antonio, en manos de una familia desde 2017: limpieza especializada, restauración de superficies y cuidado recurrente para residencias privadas. Solicite una Evaluación del Hogar.',
    line: 'Preservación y cuidado del hogar para las mejores casas de San Antonio, de la familia Leal desde 2017.',
    numbers: 'Diamond Shine en cifras',
    homes: 'Hogares atendidos [confirm:homes-8000]',
    since: 'Empresa familiar desde',
    towns: 'Comunidades que atendemos',
    method: 'Cada superficie, su propio método.',
    methodLead: 'Un producto equivocado puede opacar un piso de piedra para siempre. Elegimos el método según el material y lo revisamos con usted, área por área.',
    surfaces: [
      { name: 'Piedra y azulejo', text: 'La piedra natural, el azulejo y las juntas entre ellos, cada uno limpiado con lo que puede soportar.', pic: 'gloved-hand-stone.jpg' },
      { name: 'Madera', text: 'Gabinetes, pisos de madera y muebles finos, limpiados según su acabado.', pic: 'white-glove-detail.webp' },
      { name: 'Paredes y molduras', text: 'Pintura interior, perfilada a mano a lo largo de cada moldura.', pic: 'painting-hand.jpg' },
    ],
    care: 'Los cuidados que ofrecemos',
    careLead: 'Cada servicio se cotiza por escrito antes de empezar el trabajo.',
    prices: { '/floor-ritual': '+$25 a $35 por visita', '/white-glove-society': '$495 al año' } as Record<string, string>,
    walk: 'El recorrido',
    walkLead: 'Cada Evaluación del Hogar es un recorrido por la casa con usted. Recorra la suya aquí y marque cada área como lo haríamos nosotros.',
    rooms: [
      { name: 'La entrada', text: 'La piedra y el vidrio de la puerta, el umbral y el piso que todos pisan al entrar.', pic: 'entry.jpeg' },
      { name: 'La sala', text: 'La madera, la piedra, la chimenea y los detalles por los que se juzga una habitación.', pic: 'limestone-fireplace.jpeg' },
      { name: 'La cocina', text: 'Encimeras de piedra, frentes de gabinetes, electrodomésticos y las juntas entre los azulejos.', pic: 'stone-kitchen.jpg' },
      { name: 'Los pisos', text: 'Azulejo, juntas, madera y piedra natural, cada uno con su propio método.', pic: 'travertine.jpg' },
      { name: 'Las habitaciones alfombradas', text: 'Zonas de paso, áreas de mascotas y las habitaciones más usadas, y lo que se puede restaurar.', pic: 'carpet-room.webp' },
      { name: 'Las recámaras', text: 'La ropa de cama, las camas y las habitaciones que un invitado nota primero.', pic: 'bed-presentation.jpg' },
    ],
    marks: ['Mantener', 'Restaurar', 'Prioridad'],
    mark: 'Marcar',
    plan: 'Su plan',
    planText: 'Después del recorrido recibe un plan por escrito, en palabras claras, con cada área marcada como Mantener, Restaurar o Prioridad. Cada servicio empieza después con un acuerdo firmado que cubre el alcance, el precio, las condiciones de pago y las responsabilidades.',
    planEmpty: 'Marque una habitación arriba y aparecerá aquí.',
    planNote: 'Sin compromiso. Una solicitud no reserva una fecha ni cobra ningún pago.',
    notesIntro: 'Del recorrido en la página de inicio.',
    family: 'La familia Leal',
    familyLead: 'Lilian y Sergio Leal fundaron Diamond Shine en San Antonio en 2017, y hoy Emilio Leal la dirige. La familia con la que usted habla es la familia que responde por el trabajo.',
    voice: 'Sergio Leal, en sus propias palabras',
    work: 'Nuestro trabajo, por escrito',
    workLead: 'Cada caso describe la casa y el plan de cuidado, en palabras claras.',
    workNote: 'Fotografía ilustrativa',
    allCases: 'Todos los casos',
    allReviews: 'Todas las reseñas, completas',
    visit: 'Empiece con un recorrido',
    visitAreas: 'Casas en San Antonio, Alamo Heights, Terrell Hills, Olmos Park, Boerne y [comunidades cercanas](/service-areas).',
  },
};
const c = copy[lang];

const menu = serviceGroups.map((g) => ({
  ...g,
  items: g.links.map((l) => ({ ...l, price: c.prices[l.href] })),
}));

// The numbers band: counted from the service-area list, so it follows that list.
const towns = areas.flatMap((a) => a.towns).length;

const sergio = people.find((p) => p.slug === 'sergio-leal')!;
const remark = reviews.find((r) => r.id === 'brittney')!;
---
<Base title={c.title} description={c.description} overlay>
  <section class="hero" aria-labelledby="hero-name">
    <div class="hero-media">
      <Photo class="hero-shot" {...pic('hero-home.jpg')} show={1600} sizes="100vw" eager />
      <Photo class="hero-shot" src="courtyard-wide.webp" alt="" show={1600} sizes="100vw" />
      <Photo class="hero-shot" src="limestone-entrance.webp" alt="" show={1600} sizes="100vw" />
    </div>
    <div class="wrap hero-foot t-stagger">
      <h1 id="hero-name" class="hero-name t-stagger-line"><span>Diamond</span> <span>Shine</span></h1>
      <p class="hero-line t-stagger-line t-stagger-line--2">{c.line}</p>
      <div class="t-stagger-line t-stagger-line--3"><Cta class="btn--paper" /></div>
    </div>
  </section>

  <section class="numbers" aria-label={c.numbers}>
    <dl class="wrap numbers-in">
      <div><dt set:html={rich(c.homes)} /><dd>8,000+</dd></div>
      <div><dt>{c.since}</dt><dd>{brand.founded}</dd></div>
      <div><dt>{c.towns}</dt><dd>{towns}</dd></div>
    </dl>
  </section>

  <section class="section" aria-labelledby="method-title">
    <div class="wrap">
      <header class="center-head">
        <h2 id="method-title">{c.method}</h2>
        <p class="lead">{c.methodLead}</p>
      </header>
      <ul class="trio">
        {c.surfaces.map((s) => (
          <li class="surface">
            <Photo {...pic(s.pic)} ratio={0.8} show={440} sizes="(min-width: 641px) 31vw, 100vw" />
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section sheet-band" aria-labelledby="care-title">
    <div class="wrap">
      <div class="sheet">
        <Facets />
        <div class="sheet-in">
          <header class="center-head">
            <h2 id="care-title">{c.care}</h2>
            <p class="lead">{c.careLead}</p>
          </header>
          <div class="sheet-grid">
            {menu.map((g) => (
              <div class="sheet-group">
                <h3><a href={g.href}>{g.name}</a></h3>
                <p class="sheet-line">{g.line}</p>
                <ul>
                  {g.items.map((it) => (
                    <li><a href={it.href}>{it.label}</a>{it.price && <span class="sheet-price"> · {it.price}</span>}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <p class="sheet-hours">{t.hours.short} · {t.callOrText} <a href={brand.phoneHref}>{brand.phone}</a></p>
        </div>
        <Facets flip />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="walk-title" data-walk data-notes-intro={c.notesIntro}>
    <div class="wrap">
      <header class="center-head">
        <h2 id="walk-title">{c.walk}</h2>
        <p class="lead">{c.walkLead}</p>
      </header>
      <ol class="rooms">
        {c.rooms.map((r, i) => (
          <li class="room">
            <Photo {...pic(r.pic)} ratio={4 / 3} show={460} sizes="(min-width: 1000px) 31vw, (min-width: 641px) 47vw, 100vw" />
            <div class="room-body">
              <h3>{r.name}</h3>
              <p>{r.text}</p>
              <div class="mark" role="group" aria-label={`${c.mark} ${r.name.toLowerCase()}`} data-room={r.name} data-index={i}>
                {c.marks.map((m) => <button type="button" aria-pressed="false" data-mark={m}>{m}</button>)}
              </div>
            </div>
          </li>
        ))}
      </ol>
      <div class="plan">
        <h3>{c.plan}</h3>
        <p>{c.planText}</p>
        <ul class="plan-list" data-plan aria-live="polite"><li class="plan-empty">{c.planEmpty}</li></ul>
        <a class="btn btn--paper" data-plan-link data-cta href="/home-evaluation">{t.cta}</a>
        <p class="plan-note">{c.planNote}</p>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="family-title">
    <div class="wrap">
      <header class="center-head">
        <h2 id="family-title">{c.family}</h2>
        <p class="lead">{c.familyLead}</p>
      </header>
      <ul class="trio family">
        {people.map((p) => (
          <li>
            <a class="member" href={`/people/${p.slug}`}>
              <Photo class="portrait" src={p.portrait} alt={p.alt} ratio={0.8} show={420} position="top" sizes="(min-width: 641px) 31vw, 33vw" />
              <span class="member-name">{p.name}</span>
              <span class="member-role">{p.role}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section voice" aria-label={c.voice}>
    <div class="wrap">
      <figure class="voice-quote">
        <blockquote>&ldquo;{sergio.quote}&rdquo;</blockquote>
        <figcaption><a href={`/people/${sergio.slug}`}>{sergio.name}</a>, {sergio.role.toLowerCase()}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="work-title">
    <div class="wrap">
      <header class="center-head">
        <h2 id="work-title">{c.work}</h2>
        <p class="lead">{c.workLead}</p>
      </header>
      <ul class="trio">
        {stories.map((s) => (
          <li>
            <a class="story" href={`/transformation-stories/${s.slug}`}>
              <Photo {...pic(s.pic)} ratio={0.8} show={440} sizes="(min-width: 641px) 31vw, 100vw" />
              <span class="story-name" set:html={s.h1} />
              <span class="story-text">{s.summary}</span>
              <span class="story-note">{c.workNote}</span>
            </a>
          </li>
        ))}
      </ul>
      <figure class="remark">
        <blockquote>&ldquo;{remark.excerpt}&rdquo;</blockquote>
        <figcaption>{remark.name}, {remark.source}{t.translated && ` (${t.translated})`}</figcaption>
      </figure>
      <p class="center-actions"><a class="btn btn--line" href="/transformation-stories">{c.allCases}</a> <a class="btn btn--line" href="/reviews">{c.allReviews}</a></p>
    </div>
  </section>

  <section class="visit" aria-labelledby="visit-title">
    <Photo class="visit-photo" {...pic('arrival-entrance.webp')} show={1600} sizes="100vw" />
    <div class="wrap">
      <div class="visit-card">
        <h2 id="visit-title">{c.visit}</h2>
        <p set:html={rich(c.visitAreas)} />
        <p>{t.hours.short}<br />{t.hours.closed}</p>
        <p class="visit-status" data-office-status></p>
        <p class="visit-lines"><a href={brand.phoneHref}>{t.callOrText} {brand.phone}</a><a href={`mailto:${brand.email}`}>{brand.email}</a></p>
        <Cta />
      </div>
    </div>
  </section>
</Base>

<script>
  // The walkthrough: the visitor's own marks, listed as a plan and carried into the request, in the page's language.
  const root = document.querySelector<HTMLElement>('[data-walk]');
  if (root) {
    const plan = root.querySelector<HTMLElement>('[data-plan]')!;
    const link = root.querySelector<HTMLAnchorElement>('[data-plan-link]')!;
    const form = link.getAttribute('href')!;
    const empty = plan.firstElementChild!;
    const chosen = new Map<number, [string, string]>();

    root.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-mark]');
      if (!button) return;
      const group = button.closest<HTMLElement>('[data-room]')!;
      const on = button.getAttribute('aria-pressed') !== 'true';
      group.querySelectorAll('[data-mark]').forEach((b) => b.setAttribute('aria-pressed', String(b === button && on)));
      const index = Number(group.dataset.index);
      if (on) chosen.set(index, [group.dataset.room!, button.dataset.mark!]);
      else chosen.delete(index);

      const lines = [...chosen.entries()].sort((a, b) => a[0] - b[0]).map(([, pair]) => pair);
      plan.replaceChildren(
        ...(lines.length
          ? lines.map(([room, mark]) => {
              const li = document.createElement('li');
              const name = document.createElement('span');
              const value = document.createElement('strong');
              name.textContent = room;
              value.textContent = mark;
              li.append(name, value);
              return li;
            })
          : [empty]),
      );
      const notes = lines.map(([room, mark]) => `${room}: ${mark}`).join('; ');
      link.href = notes ? `${form}?notes=${encodeURIComponent(`${root.dataset.notesIntro} ${notes}.`)}` : form;
    });
  }
</script>

<style is:global>
  /* one centred axis for the whole page: headings and leads sit on it, grids divide around it in equal parts */
  .center-head { max-width: 760px; margin-inline: auto; text-align: center; }
  .center-head .lead { margin-top: 20px; }
  .center-head + * { margin-top: clamp(48px, 5vw, 72px); }

  /* hero: the house, the name across it, everything on the centre line */
  .hero { position: relative; isolation: isolate; display: grid; align-items: end; min-height: 100svh; overflow: hidden; background: var(--navy); color: var(--white); }
  .hero-media { position: absolute; inset: 0; z-index: -2; }
  .hero-shot { position: absolute; inset: 0; }
  .hero-shot + .hero-shot { opacity: 0; }
  .hero-shot picture, .hero-shot img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hero::before { content: ''; position: absolute; inset: 0 0 auto; z-index: -1; height: 180px; background: linear-gradient(rgb(0 10 26 / 0.5), rgb(0 10 26 / 0)); } /* taste-skill-ignore: scrim over the photograph */
  .hero::after { content: ''; position: absolute; inset: auto 0 0; z-index: -1; height: 62%; background: linear-gradient(to top, rgb(0 10 26 / 0.8), rgb(0 10 26 / 0)); } /* taste-skill-ignore: scrim over the photograph */
  .hero-foot { container-type: inline-size; display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; gap: clamp(20px, 2.2vw, 32px); width: 100%; padding-bottom: clamp(44px, 5vw, 72px); text-align: center; }
  .hero-name { font-size: var(--step-name); line-height: 0.8; letter-spacing: -0.035em; color: var(--white); white-space: nowrap; }
  .hero-line { max-width: 44ch; font-size: var(--step-lead); line-height: 1.4; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-media { animation: hero-drift 26s ease-in-out infinite alternate; }
    .hero-shot:nth-child(2) { animation: hero-two 18s infinite; }
    .hero-shot:nth-child(3) { animation: hero-three 18s infinite; }
  }
  @keyframes hero-drift { from { transform: scale(1); } to { transform: scale(1.06); } }
  @keyframes hero-two { 0%, 33.3% { opacity: 0; } 42.2%, 91.1% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes hero-three { 0%, 66.7% { opacity: 0; } 75.6%, 91.1% { opacity: 1; } 100% { opacity: 0; } }
  @media (max-width: 640px) {
    .hero-name { font-size: 21vw; line-height: 0.88; white-space: normal; }
    .hero-name span { display: block; }
  }

  /* the numbers, large and in three equal columns, straight after the photograph */
  .numbers { padding-block: clamp(48px, 6vw, 88px); background: var(--navy); color: var(--white); }
  .numbers-in { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px var(--gap); text-align: center; }
  .numbers-in > div { display: flex; flex-direction: column-reverse; gap: 12px; }
  .numbers dd { font-family: var(--display); font-size: var(--step-head); font-weight: 500; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: lining-nums; }
  .numbers dt { color: var(--sky); letter-spacing: 0.02em; }
  @media (max-width: 640px) { .numbers-in { grid-template-columns: 1fr; } }

  /* three equal columns, the same picture size in each */
  .trio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(36px, 3vw, 48px) var(--gap); }
  .trio > li { display: flex; flex-direction: column; }
  .trio > li > a { flex: 1; }
  .surface, .member, .story { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .surface .photo, .member .photo, .story .photo { width: 100%; }
  .surface h3 { margin-top: 24px; }
  .surface p { max-width: 30ch; margin-top: 10px; }
  @media (max-width: 640px) {
    .trio:not(.family) { grid-template-columns: 1fr; }
    .trio:not(.family) .photo img { aspect-ratio: 3 / 2; object-fit: cover; }
  }

  /* the service card, printed on paper and cut like the diamond */
  .sheet-band { background: var(--navy); }
  .sheet { position: relative; background: var(--paper); }
  .sheet > .facets { position: absolute; left: 0; right: 0; }
  .sheet > .facets:first-child { top: -10px; }
  .sheet > .facets:last-child { bottom: -10px; }
  .sheet-in { padding: clamp(56px, 7vw, 104px) clamp(24px, 5vw, 80px); }
  .sheet-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(48px, 5vw, 72px) clamp(24px, 3vw, 48px); text-align: center; }
  .sheet-group h3 a { color: var(--navy); text-decoration: none; }
  .sheet-group h3 a:hover { color: var(--blue); }
  .sheet-line { max-width: 32ch; margin: 10px auto 0; font-size: var(--step-small); color: var(--muted); }
  .sheet-group ul { display: grid; gap: 2px; margin-top: 18px; }
  .sheet-group li a { display: inline-flex; align-items: center; min-height: 36px; color: var(--navy); text-decoration: none; }
  .sheet-group li a:hover { color: var(--blue); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.24em; }
  .sheet-price { font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--muted); }
  .sheet-hours { margin-top: clamp(56px, 6vw, 80px); font-size: var(--step-small); text-align: center; color: var(--muted); }
  @media (max-width: 999px) { .sheet-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .sheet-band .wrap { padding-inline: 10px; }
    .sheet-grid { grid-template-columns: 1fr; }
  }

  /* the walkthrough: six equal rooms, then the visitor's plan on the centre line */
  .rooms { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
  .room { display: flex; flex-direction: column; background: var(--ice); }
  .room-body { display: flex; flex: 1; flex-direction: column; align-items: center; padding: 28px clamp(20px, 2vw, 32px) 32px; text-align: center; }
  .room-body p { max-width: 32ch; margin-top: 10px; }
  .mark { display: none; width: 100%; gap: 6px; margin-top: auto; padding-top: 24px; }
  .js .mark { display: flex; }

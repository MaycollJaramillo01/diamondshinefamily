---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Sections from '../components/Sections.astro';
import ProofLine from '../components/ProofLine.astro';
import EvaluationForm from '../components/EvaluationForm.astro';
import { rich } from '../lib/rich';
import { brand } from '../data/brand';
import { langOf, ui } from '../lib/i18n';
import type { Section } from '../data/page-types';

const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const copy = {
  en: {
    title: 'Contact Diamond Shine, Home Care in San Antonio, TX',
    description: `Call or text ${brand.phone}, or write to ${brand.email}, to discuss cleaning, restoration or recurring care for a home in San Antonio. A member of our family follows up personally.`,
    h1: 'Talk to the family about your&nbsp;home.',
    lead: 'Reach out to discuss recurring care, restoration or a plan for your San Antonio home or property. A member of our family will follow up personally.',
    reach: 'Reach us directly',
    phone: 'Phone and text',
    email: 'Email',
    hours: 'Hours',
    area: 'Service area',
    areaText: 'San Antonio, Texas, and [surrounding communities](/service-areas)',
    follow: 'Follow us',
    payment: [
      {
        kind: 'plate',
        title: 'How payment works',
        text: 'Zelle is our primary payment method. For client convenience, secure digital payments may also be available through Square, including major credit cards, debit cards, approved digital invoice payments and ACH or bank transfer options when available. [confirm:square]',
        pic: 'limestone-entrance.webp',
        note: 'Payment terms are set out in your signed agreement. No payment is collected on this website.',
      },
    ] as Section[],
  },
  es: {
    title: 'Contacte a Diamond Shine, cuidado del hogar en San Antonio, TX',
    description: `Llame o escriba al ${brand.phone}, o escriba a ${brand.email}, para hablar de limpieza, restauración o cuidado recurrente para una casa en San Antonio. Un miembro de la familia le responderá en persona.`,
    h1: 'Hable con la familia sobre su&nbsp;casa.',
    lead: 'Comuníquese para hablar de cuidado recurrente, restauración o un plan para su casa o propiedad en San Antonio. Un miembro de nuestra familia le dará seguimiento en persona.',
    reach: 'Contáctenos directamente',
    phone: 'Teléfono y mensajes',
    email: 'Correo electrónico',
    hours: 'Horario',
    area: 'Zona de servicio',
    areaText: 'San Antonio, Texas, y [las comunidades cercanas](/service-areas)',
    follow: 'Síganos',
    payment: [
      {
        kind: 'plate',
        title: 'Cómo funcionan los pagos',
        text: 'Zelle es nuestro método de pago principal. Para comodidad del cliente, también puede haber pagos digitales seguros a través de Square, incluidas las principales tarjetas de crédito y débito, el pago de facturas digitales aprobadas y opciones de ACH o transferencia bancaria cuando estén disponibles. [confirm:square]',
        pic: 'limestone-entrance.webp',
        note: 'Las condiciones de pago se establecen en su acuerdo firmado. En este sitio web no se cobra ningún pago.',
      },
    ] as Section[],
  },
};
const c = copy[lang];
---
<Base title={c.title} description={c.description} service="not-sure" ctaHref="#evaluation-form">
  <PageHero h1={c.h1} lead={c.lead} main="courtyard-wide.webp" action={{ label: `${t.callOrText} ${brand.phone}`, href: brand.phoneHref }} />

  <section class="section" aria-labelledby="c-title">
    <div class="wrap split split--top">
      <div class="stack">
        <h2 id="c-title">{c.reach}</h2>
        <dl class="contact-list">
          <div><dt>{c.phone}</dt><dd><a href={brand.phoneHref}>{brand.phone}</a></dd></div>
          <div><dt>{c.email}</dt><dd><a href={`mailto:${brand.email}`}>{brand.email}</a></dd></div>
          <div><dt>{c.hours}</dt><dd>{t.hours.text}<br />{t.hours.closed}<br /><span class="muted" data-office-status></span></dd></div>
          <div><dt>{c.area}</dt><dd set:html={rich(c.areaText)} /></div>
          <div><dt>{c.follow}</dt><dd><a href={brand.socials.facebook} rel="noopener">Facebook</a>, <a href={brand.socials.instagram} rel="noopener">Instagram</a>, <a href={brand.socials.google} rel="noopener">Google</a></dd></div>
        </dl>
        <ProofLine review="kristina" />
      </div>
      <div class="form-card">
        <EvaluationForm service="not-sure" />
      </div>
    </div>
  </section>

  <Sections sections={c.payment} startSoft />
</Base>

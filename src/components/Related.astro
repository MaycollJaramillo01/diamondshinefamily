---
// Where to go next from this page: context, not a second call to action.
import { rich } from '../lib/rich';
import More from './More.astro';
import { langOf, ui } from '../lib/i18n';

interface Props {
  items: { label: string; href: string; line: string }[];
  title?: string;
  soft?: boolean;
}
const t = ui[langOf(Astro.currentLocale)];
const { items, title = t.related, soft = true } = Astro.props;
---
<section class:list={['section', { 'section--soft': soft }]}>
  <div class="wrap">
    <div class="section-head"><h2>{title}</h2></div>
    <div class="cards cards--fit">
      {items.map((r) => (
        <a class="card t-learn" href={r.href}>
          <div class="card-body card-body--flat">
            <strong class="card-title">{r.label}</strong>
            <span class="muted" set:html={rich(r.line)} />
            <More label={t.seeDetails} />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

---
// The translation help from the company's original site, kept word for word. The browser does the translating;
// these lines say how, in English or Spanish. Nothing here starts a translation or claims a reviewed Spanish site.
const copy = {
  en: {
    title: 'Read our website in your language',
    intro: 'Use your browser’s translation feature to read this page in Spanish or another available language.',
    legend: 'Instructions in',
    safari: 'On iPhone or iPad, open the page menu beside the address bar and choose Translate to your language, when available.',
    mac: 'On Mac, choose the translation icon in Safari’s address field, then select a language.',
    chrome: 'On iPhone or iPad, open the three-dot menu in Chrome and choose Translate. Use the language settings in the translation panel to choose another language.',
    availability: 'Available languages depend on your browser, device and region. These controls explain how to translate; they do not start browser translation.',
    email: 'Choose your confirmation email language separately in the request form. Translating the page does not change that choice.',
    help: 'Browser help',
    close: 'Done',
  },
  es: {
    title: 'Lea nuestro sitio web en su idioma',
    intro: 'Use la función de traducción de su navegador para leer esta página en español u otro idioma disponible.',
    legend: 'Idioma de las instrucciones',
    safari: 'En iPhone o iPad, abra el menú de la página junto a la barra de direcciones y elija la opción de traducir a su idioma, si está disponible.',
    mac: 'En Mac, seleccione el icono de traducción en la barra de direcciones de Safari y elija un idioma.',
    chrome: 'En iPhone o iPad, abra el menú de tres puntos de Chrome y elija Traducir. Puede elegir otro idioma en la configuración del panel de traducción.',
    availability: 'Los idiomas disponibles dependen de su navegador, dispositivo y región. Estos controles muestran instrucciones; no activan la traducción del navegador.',
    email: 'Elija por separado el idioma de su correo de confirmación en el formulario. Traducir la página no cambia esa selección.',
    help: 'Ayuda del navegador',
    close: 'Listo',
  },
};
const langs = Object.entries(copy);
const help = [
  ['Safari · iPhone', 'https://support.apple.com/guide/iphone/browse-the-web-iph1fbef4daa/ios'],
  ['Safari · Mac', 'https://support.apple.com/guide/safari/translate-a-webpage-ibrw646b2ca2/mac'],
  ['Chrome', 'https://support.google.com/chrome/answer/173424?hl=en&co=GENIE.Platform%3DiOS'],
];
---
<dialog id="translate" class="translate t-modal" aria-labelledby="translate-title-en" data-translate>
  <div class="translate-in">
    {langs.map(([code, c]) => (
      <div lang={code} data-lang={code} hidden={code !== 'en'}>
        <h2 id={`translate-title-${code}`}>{c.title}</h2>
        <p>{c.intro}</p>
      </div>
    ))}
    <div>
      <p class="small">{langs.map(([code, c]) => <span lang={code} data-lang={code} hidden={code !== 'en'}>{c.legend}</span>)}</p>
      <div class="translate-langs" role="group" aria-label="Instructions in / Idioma de las instrucciones">
        <button type="button" lang="en" translate="no" aria-pressed="true" data-pick="en">English</button>
        <button type="button" lang="es" translate="no" aria-pressed="false" data-pick="es">Español</button>
      </div>
    </div>
    {langs.map(([code, c]) => (
      <div lang={code} data-lang={code} hidden={code !== 'en'}>
        <h3>Safari · iPhone / iPad</h3>
        <p>{c.safari}</p>
        <h3>Safari · Mac</h3>
        <p>{c.mac}</p>
        <h3>Chrome · iPhone / iPad</h3>
        <p>{c.chrome}</p>
        <p class="small">{c.availability}</p>
        <p>{c.email}</p>
        <p class="small translate-help">{c.help}: {help.map(([label, href]) => <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>)}</p>
        <button type="button" class="btn" data-translate-close>{c.close}</button>
      </div>
    ))}
  </div>
</dialog>

<script>
  // transitions.dev modal: open scales up from --modal-scale, close dips back before the dialog shuts.
  const dialog = document.querySelector<HTMLDialogElement>('[data-translate]');
  const opener = document.querySelector<HTMLButtonElement>('[data-translate-open]');
  if (dialog && opener) {
    const closeMs = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--modal-close-dur')) || 150;
    const pick = (code: string) => {
      for (const el of dialog.querySelectorAll<HTMLElement>('[data-lang]')) el.hidden = el.dataset.lang !== code;
      for (const b of dialog.querySelectorAll<HTMLButtonElement>('[data-pick]')) b.setAttribute('aria-pressed', String(b.dataset.pick === code));
      dialog.setAttribute('aria-labelledby', `translate-title-${code}`);
    };
    const close = () => {
      dialog.classList.replace('is-open', 'is-closing');
      setTimeout(() => {
        dialog.classList.remove('is-closing');
        dialog.close();
      }, closeMs);
    };
    opener.addEventListener('click', () => {
      pick('en');
      dialog.showModal();
      void dialog.offsetWidth;
      dialog.classList.add('is-open');
    });
    // Escape and a click outside close it the same way as the button.
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const choice = target.closest<HTMLButtonElement>('[data-pick]');
      if (choice) pick(choice.dataset.pick!);
      else if (target === dialog || target.closest('[data-translate-close]')) close();
    });
  }
</script>

---
// The verifiable proof that sits beside every call to action: a real recommendation and the family's founding.
import { data, langOf, ui } from '../lib/i18n';

const { review = 'serena', class: cls } = Astro.props;
const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const r = data[lang].reviews.find((x) => x.id === review)!;
---
<p class:list={['proof', cls]}>
  &ldquo;{r.excerpt}&rdquo; <a href="/reviews">{r.name}, {r.source}</a>{t.translated && ` (${t.translated})`}. {t.familyOwned}
</p>

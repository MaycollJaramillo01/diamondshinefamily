---
// Frames left honestly empty: the photograph waits for the client's written approval.
import { langOf, ui } from '../lib/i18n';

interface Props {
  groups: { name: string; line: string; frames: string[] }[];
}
const { groups } = Astro.props;
const t = ui[langOf(Astro.currentLocale)].frames;
---
<section class="section" aria-labelledby="frames-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="frames-title">{t.title}</h2>
      <p>{t.text}</p>
    </div>
    {groups.map((g) => (
      <div class="frames-group">
        <h3>{g.name}</h3>
        <p class="muted">{g.line}</p>
        <div class="frames">
          {g.frames.map((f) => (
            <div class="frame-empty">
              <p><strong>{f}</strong><br /><span class="small muted">{t.pending}</span></p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

---
// How a page ends: one sentence, the call to action with proof and credentials beside it, and two ways to talk.
import Photo from './Photo.astro';
import Cta from './Cta.astro';
import ProofLine from './ProofLine.astro';
import { pic } from '../data/pictures';
import { rich } from '../lib/rich';
import { brand } from '../data/brand';
import { langOf, ui } from '../lib/i18n';

interface Props {
  title: string;
  text: string;
  picture?: string;
  service?: string;
  review?: string;
  action?: { label: string; href: string };
}
const { title, text, picture = 'gloved-hand-stone.jpg', service, review = 'rob', action } = Astro.props;
const t = ui[langOf(Astro.currentLocale)];
---
<section class="section on-navy">
  <div class="wrap split">
    <div class="close-copy">
      <h2 set:html={title} />
      <p class="lead" set:html={rich(text)} />
      {action ? (
        <p class="actions"><a class="btn btn--line" href={action.href}>{action.label}</a></p>
      ) : (
        <>
          <div class="actions">
            <Cta service={service} />
            <a class="btn btn--line" href={brand.phoneHref}>{t.call} {brand.phone}</a>
          </div>
          <ProofLine review={review} />
          <p class="creds" set:html={rich(t.creds)} />
        </>
      )}
      <p class="small"><a href={`mailto:${brand.email}`}>{brand.email}</a></p>
    </div>
    <Photo class="close-pic" {...pic(picture)} ratio={1.5} show={560} sizes="46vw" />
  </div>
</section>

---
// The "See details" line at the foot of a card. The card link around it carries .t-learn, so hovering anywhere on the card opens the chevron.
const { label } = Astro.props;
---
<span class="card-more">{label}<span class="t-learn-chevron" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="t-learn-arm t-learn-arm-top" d="M6 4L10 8" /><path class="t-learn-arm t-learn-arm-bot" d="M10 8L6 12" /></svg></span></span>
